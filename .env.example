# Postgres is the only supported backend. `npm run db:up` starts one locally
# with these credentials; the server exits on boot if this is unset.
# 127.0.0.1 rather than localhost: the container binds IPv4 loopback, and Node
# resolves localhost to ::1 first, which would be refused.
DATABASE_URL=postgresql://autocal:autocal@127.0.0.1:5434/autocal
PORT=3001

# Return the magic link directly in the requestMagicLink response so users can
# sign in without an email provider (dev-style login). Enabled automatically
# outside production; set here to enable it on a local/secure-network prod
# deployment. Never enable on a public deployment.
# EXPOSE_MAGIC_LINK=true

# Set to an existing user UUID to allow that user to auth with their UUID as a
# Bearer token (bypasses magic-link). Local/secure networks only.
# BYPASS_AUTH_UUID=00000000-0000-0000-0000-000000000001

# Client — client/.env (Expo EXPO_PUBLIC_ vars are inlined at build time)
# The web dev server runs on port 3000; the API/server on 3001.
# EXPO_PUBLIC_API_URL=http://localhost:3001
